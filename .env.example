# Tenon configuration — copy to .env and fill in your own values.
# .env is gitignored; never commit a real key.

# API key for an OpenAI-compatible endpoint (required)
TENON_API_KEY=sk-your-key-here

# Base URL of an OpenAI-compatible chat completions endpoint
TENON_BASE_URL=https://api.siliconflow.cn/v1

# Model on that endpoint; must support native tool calling.
# Examples: deepseek-ai/DeepSeek-V3.1, moonshotai/Kimi-K2-Instruct
TENON_MODEL=deepseek-ai/DeepSeek-V3.1
